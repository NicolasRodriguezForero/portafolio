---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Nicolas Rodriguez Forero — Ingeniero en Inteligencia Artificial',
  description = 'Portafolio de Nicolás Rodríguez Forero, Ingeniero en Inteligencia Artificial (Cum Laude): sistemas RAG, agentes con LangGraph y búsqueda híbrida llevados a producción con Python, FastAPI y Azure.',
} = Astro.props;

const canonicalURL = Astro.site ?? new URL('https://nicolasrodriguez.online');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Nicolas Rodriguez Forero" />
    <meta name="theme-color" content="#050A0F" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/og-image.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/images/og-image.png" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <div id="scroll-progress" aria-hidden="true"></div>
    <div id="ambient" aria-hidden="true"><span></span><span></span><span></span></div>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<script>
  import { initI18n } from '../scripts/i18n';
  import { initLenis, initSmoothAnchorLinks } from '../scripts/lenis';
  import { initCursor } from '../scripts/cursor';
  import { initTypewriter } from '../scripts/typewriter';
  import {
    initHeroEntrance,
    initScrollReveals,
    initTimelineLine,
    initSectionLabels,
  } from '../scripts/animations';
  import { initCardGlow, initScrollProgress, initHeroPause } from '../scripts/glow';

  // i18n first: patches DOM to correct language and sets __typewriterRoles
  initI18n();
  // Lenis must be before GSAP — ScrollTrigger integration depends on it
  initLenis();
  initSmoothAnchorLinks();
  initHeroEntrance();
  // Typewriter reads __typewriterRoles set by initI18n
  initTypewriter('typewriter-text');
  initCursor();
  initScrollReveals();
  initTimelineLine();
  initSectionLabels();
  initCardGlow();
  initScrollProgress();
  initHeroPause();
</script>
