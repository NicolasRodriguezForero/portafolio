---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Nicolas Rodriguez Forero — Desarrollador Full Stack & IA',
  description = 'Portfolio de Nicolas Rodriguez Forero, Desarrollador Full Stack e Ingeniero en Ciencias de la Computación e Inteligencia Artificial. Universidad Sergio Arboleda, Bogotá.',
} = Astro.props;

const canonicalURL = Astro.site ?? new URL('https://nicolasrodriguez.dev');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Nicolas Rodriguez Forero" />
    <meta name="theme-color" content="#050A0F" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/images/og-image.png" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_CO" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/images/og-image.png" />

    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<script>
  import { initLenis, initSmoothAnchorLinks } from '../scripts/lenis';
  import { initCursor } from '../scripts/cursor';
  import { initTypewriter } from '../scripts/typewriter';
  import {
    initHeroEntrance,
    initScrollReveals,
    initTimelineLine,
    initSectionLabels,
  } from '../scripts/animations';
  import { initProjectsCarousel } from '../scripts/carousel';

  // Lenis must be first — ScrollTrigger integration depends on it
  initLenis();
  initSmoothAnchorLinks();
  initHeroEntrance();
  initTypewriter('typewriter-text');
  initCursor();
  initScrollReveals();
  initTimelineLine();
  initSectionLabels();
  initProjectsCarousel();
</script>
