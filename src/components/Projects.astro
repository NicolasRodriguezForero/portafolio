---
import { projects } from '../data/projects';
---

<section id="projects">
  <div class="projects-header section">
    <p class="section-label">03 — PROYECTOS</p>
    <h2 class="section-heading" data-reveal>
      Lo que he<br />
      <span class="gradient-text">construido.</span>
    </h2>
    <p class="projects-hint" data-reveal>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
      Arrastra para explorar
    </p>
  </div>

  <div id="projects-wrapper">
    <div id="projects-track">
      {projects.map((project) => (
        <article
          class={`project-card gradient-border ${project.accentColor}`}
          data-tilt
        >
          <div class={`card-accent ${project.accentColor}`}></div>

          <div class="card-body">
            <div class="card-top">
              <div class="card-status">
                <span class={`status-dot ${project.status}`}></span>
                <span class="status-text">
                  {project.status === 'active' ? 'Activo' : project.status === 'completed' ? 'Completado' : 'En progreso'}
                </span>
              </div>
              <div class="card-links">
                {project.githubUrl && (
                  <a
                    href={project.githubUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Ver ${project.title} en GitHub`}
                    class="card-link"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
                    </svg>
                  </a>
                )}
                {project.demoUrl && (
                  <a
                    href={project.demoUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Ver demo de ${project.title}`}
                    class="card-link"
                  >
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
                    </svg>
                  </a>
                )}
              </div>
            </div>

            <h3 class="card-title">{project.title}</h3>
            <p class="card-desc">{project.description}</p>

            <div class="card-tags">
              {project.tags.slice(0, 4).map((tag) => (
                <span class={`tag ${project.accentColor}`}>{tag}</span>
              ))}
              {project.tags.length > 4 && (
                <span class="tag more">+{project.tags.length - 4}</span>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  #projects {
    border-top: 1px solid #1A2535;
    overflow: hidden;
  }

  .projects-header {
    padding-bottom: 2rem;
  }

  .section-heading {
    font-family: 'Syne', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1.15;
    color: #E8EDF2;
    margin-top: 1rem;
    margin-bottom: 1rem;
  }

  .projects-hint {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4A6070;
  }

  /* Carousel */
  #projects-wrapper {
    overflow: hidden;
    padding: 1rem clamp(1.25rem, 5vw, 6rem) clamp(4rem, 8vh, 6rem);
    cursor: grab;
  }
  #projects-wrapper:active {
    cursor: grabbing;
  }

  #projects-track {
    display: flex;
    gap: 1.5rem;
    width: max-content;
    user-select: none;
  }

  /* Cards */
  .project-card {
    width: 360px;
    flex-shrink: 0;
    background: #0D1520;
    border-radius: 10px;
    overflow: hidden;
    transform-style: preserve-3d;
    transition: box-shadow 0.3s ease;
    position: relative;
  }

  .project-card:hover {
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.4);
  }

  .card-accent {
    height: 2px;
    width: 100%;
  }
  .card-accent.green {
    background: linear-gradient(90deg, #00FF87, transparent);
  }
  .card-accent.cyan {
    background: linear-gradient(90deg, #00CFFF, transparent);
  }

  .card-body {
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    height: calc(100% - 2px);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .card-status {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .status-dot.active    { background: #00FF87; box-shadow: 0 0 6px #00FF87; }
  .status-dot.completed { background: #00CFFF; }
  .status-dot.wip       { background: #FFB347; }
  .status-text {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4A6070;
  }

  .card-links {
    display: flex;
    gap: 0.75rem;
  }
  .card-link {
    color: #4A6070;
    transition: color 0.2s ease;
    display: flex;
    align-items: center;
  }
  .card-link:hover { color: #E8EDF2; }

  .card-title {
    font-family: 'Syne', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1.15rem;
    color: #E8EDF2;
    line-height: 1.3;
  }

  .card-desc {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.85rem;
    font-weight: 300;
    color: #8899AA;
    line-height: 1.7;
    flex: 1;
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: auto;
  }
  .tag {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
    background: #050A0F;
    border: 1px solid #1A2535;
    color: #8899AA;
  }
  .tag.green { border-color: #00FF8730; color: #00FF87; background: #00FF8710; }
  .tag.cyan  { border-color: #00CFFF30; color: #00CFFF; background: #00CFFF10; }
  .tag.more  { color: #4A6070; }

  /* Mobile: vertical stack */
  @media (max-width: 768px) {
    #projects-wrapper {
      overflow: visible;
      cursor: default;
    }
    #projects-track {
      flex-direction: column;
      width: 100%;
    }
    .project-card {
      width: 100%;
    }
  }
</style>
