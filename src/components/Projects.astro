---
import { projects } from '../data/projects';

const featured = projects.filter((p) => p.featured);
const others = projects.filter((p) => !p.featured);

const GITHUB_PATH =
  'M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z';
const EXTERNAL_PATH = 'M7 17 17 7M8 7h9v9';
---

<section id="projects">
  <div class="section">
    <p class="section-label" data-i18n="projects.label">03 — PROYECTOS</p>
    <h2 class="section-heading" data-reveal data-i18n-html="projects.heading">
      Lo que he<br />
      <span class="gradient-text">construido.</span>
    </h2>
    <p class="section-sub" data-reveal data-i18n="projects.sub">Sistemas que diseñé y construí; varios ya están en producción.</p>

    <!-- Featured: numbered editorial rows -->
    <ol class="feature-list">
      {featured.map((project, i) => (
        <li class={`feature ${project.accentColor}`} data-reveal>
          <span class="feature-index" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>

          <div class="feature-main">
            {project.period && (
              <span class={`feature-period ${project.accentColor}`} data-i18n={`project.${project.id}.period`}>{project.period}</span>
            )}
            <h3 class="feature-title" data-i18n={`project.${project.id}.title`}>{project.title}</h3>
            {project.role && <p class="feature-role" data-i18n={`project.${project.id}.role`}>{project.role}</p>}
            <p class="feature-desc" data-i18n={`project.${project.id}.description`}>{project.description}</p>

            {(project.githubUrl || project.demoUrl) && (
              <div class="feature-links">
                {project.demoUrl && (
                  <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" class={`feature-link ${project.accentColor}`}>
                    <span data-i18n="projects.demo">Ver demo</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={EXTERNAL_PATH} /></svg>
                  </a>
                )}
                {project.githubUrl && (
                  <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" class="feature-link muted">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={GITHUB_PATH} /></svg>
                    <span>GitHub</span>
                  </a>
                )}
              </div>
            )}
          </div>

          <div class="feature-side">
            {project.highlights && (
              <ul class="feature-highlights">
                {project.highlights.map((h, hi) => (
                  <li>
                    <span class={`bullet ${project.accentColor}`}>▸</span>
                    <span data-i18n={`project.${project.id}.h${hi}`}>{h}</span>
                  </li>
                ))}
              </ul>
            )}
            <div class="tags">
              {project.tags.map((tag) => (
                <span class={`tag ${project.accentColor}`}>{tag}</span>
              ))}
            </div>
          </div>
        </li>
      ))}
    </ol>

    {others.length > 0 && (
      <>
        <h3 class="others-label" data-reveal data-i18n="projects.others">Otros proyectos</h3>
        <ul class="other-list">
          {others.map((project) => (
            <li class="other" data-reveal>
              <h4 class="other-title" data-i18n={`project.${project.id}.title`}>{project.title}</h4>
              <p class="other-desc" data-i18n={`project.${project.id}.description`}>{project.description}</p>
              <div class="tags">
                {project.tags.map((tag) => (
                  <span class="tag plain">{tag}</span>
                ))}
              </div>
              <div class="other-links">
                {project.githubUrl && (
                  <a href={project.githubUrl} target="_blank" rel="noopener noreferrer" aria-label={`GitHub — ${project.title}`} class="icon-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={GITHUB_PATH} /></svg>
                  </a>
                )}
                {project.demoUrl && (
                  <a href={project.demoUrl} target="_blank" rel="noopener noreferrer" aria-label={`Demo — ${project.title}`} class="icon-link">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d={EXTERNAL_PATH} /></svg>
                  </a>
                )}
              </div>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>
</section>

<style>
  #projects {
    border-top: 1px solid #1A2535;
  }

  .section-heading {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #E8EDF2;
    margin-top: 1rem;
    margin-bottom: 3rem;
  }

  /* ── Featured rows ───────────────────────────────────── */
  .feature-list { list-style: none; }

  .feature {
    display: grid;
    grid-template-columns: 90px 1.15fr 1fr;
    gap: 2.5rem;
    padding: 2.75rem 0;
    border-top: 1px solid #1A2535;
  }
  .feature:last-child { border-bottom: 1px solid #1A2535; }

  /* Big outlined number that fills with the accent on hover */
  .feature-index {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 800;
    font-size: 3.25rem;
    line-height: 1;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1px #2A3A4D;
    transition: color 0.35s ease, -webkit-text-stroke-color 0.35s ease;
  }
  .feature.green:hover .feature-index { color: #00FF8722; -webkit-text-stroke-color: #00FF87; }
  .feature.cyan:hover  .feature-index { color: #00CFFF22; -webkit-text-stroke-color: #00CFFF; }

  .feature-main,
  .feature-side {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .feature-period {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 0.2rem 0.65rem;
    border-radius: 100px;
    width: fit-content;
  }
  .feature-period.green { background: #00FF8710; border: 1px solid #00FF8730; color: #00FF87; }
  .feature-period.cyan  { background: #00CFFF10; border: 1px solid #00CFFF30; color: #00CFFF; }

  .feature-title {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: #E8EDF2;
  }

  .feature-role {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.8rem;
    color: #4A6070;
    letter-spacing: 0.03em;
  }

  .feature-desc {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.92rem;
    color: #8899AA;
    line-height: 1.7;
  }

  .feature-links {
    display: flex;
    gap: 1.25rem;
    margin-top: 0.25rem;
  }
  .feature-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .feature-link:hover { opacity: 0.75; }
  .feature-link.green { color: #00FF87; }
  .feature-link.cyan  { color: #00CFFF; }
  .feature-link.muted { color: #8899AA; }

  .feature-highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding-top: 0.35rem;
  }
  .feature-highlights li {
    display: flex;
    gap: 0.5rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.85rem;
    color: #A0B4C8;
    line-height: 1.6;
  }
  .bullet { flex-shrink: 0; font-size: 0.65rem; margin-top: 0.3rem; }
  .bullet.green { color: #00FF87; }
  .bullet.cyan  { color: #00CFFF; }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.25rem;
  }
  .tag {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
    border: 1px solid #1A2535;
    color: #8899AA;
  }
  .tag.green { border-color: #00FF8730; color: #00FF87; background: #00FF8710; }
  .tag.cyan  { border-color: #00CFFF30; color: #00CFFF; background: #00CFFF10; }

  /* ── Other projects: compact list ────────────────────── */
  .others-label {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #4A6070;
    margin: 3.5rem 0 0.5rem;
  }

  .other-list { list-style: none; }

  .other {
    display: grid;
    grid-template-columns: 240px 1fr 220px 60px;
    align-items: center;
    gap: 1.5rem;
    padding: 1.15rem 0.75rem;
    border-bottom: 1px solid #1A2535;
    transition: background-color 0.25s ease;
  }
  .other:hover { background: rgba(255, 255, 255, 0.02); }

  .other-title {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    color: #E8EDF2;
  }
  .other-desc {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.82rem;
    color: #8899AA;
    line-height: 1.55;
  }
  .other .tags { margin-top: 0; }

  .other-links {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
  }
  .icon-link {
    color: #4A6070;
    display: flex;
    transition: color 0.2s ease;
  }
  .icon-link:hover { color: #00FF87; }

  @media (max-width: 1000px) {
    .feature { grid-template-columns: 70px 1fr; }
    .feature-side { grid-column: 2; }
    .other { grid-template-columns: 1fr auto; }
    .other-desc, .other .tags { grid-column: 1 / -1; }
    .other-links { grid-row: 1; grid-column: 2; }
  }

  @media (max-width: 640px) {
    .feature { grid-template-columns: 1fr; gap: 1rem; padding: 2rem 0; }
    .feature-side { grid-column: auto; }
    .feature-index { font-size: 2.5rem; }
  }
</style>
