---
// `sections` lists every section that should light up the link (Skills covers the stack and soft skills)
const navLinks = [
  { href: '#hero',       label: 'Inicio',       key: 'nav.home',       sections: ['hero']            },
  { href: '#about',      label: 'Sobre mí',     key: 'nav.about',      sections: ['about']           },
  { href: '#experience', label: 'Experiencia',  key: 'nav.experience', sections: ['experience']      },
  { href: '#projects',   label: 'Proyectos',    key: 'nav.projects',   sections: ['projects']        },
  { href: '#stack',      label: 'Habilidades',  key: 'nav.skills',     sections: ['stack', 'skills'] },
  { href: '#education',  label: 'Educación',    key: 'nav.education',  sections: ['education']       },
  { href: '#contact',    label: 'Contacto',     key: 'nav.contact',    sections: ['contact']         },
];
---

<header id="navbar">
  <nav>
    <a href="/" class="brand" aria-label="Nicolas Rodriguez Forero">
      <img
        src="/images/logo.webp"
        width="56"
        height="30"
        alt="Logo Nicolas Rodriguez"
        class="brand-logo"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
      />
      <span class="brand-text gradient-text" style="display:none;">NRF</span>
    </a>

    <ul class="nav-links" role="list">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="nav-link" data-i18n={link.key} data-sections={link.sections.join(' ')}>{link.label}</a>
        </li>
      ))}
    </ul>

    <div class="nav-right">
      <!-- Language dropdown: label shows the current language (set by scripts/i18n.ts) -->
      <div class="lang-select">
        <button
          class="lang-trigger"
          type="button"
          aria-haspopup="listbox"
          aria-expanded="false"
          data-i18n-aria="nav.lang.aria"
          aria-label="Cambiar idioma"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
          </svg>
          <span class="lang-current">Español</span>
          <svg class="lang-chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </button>
        <ul class="lang-menu" role="listbox">
          <li><button type="button" class="lang-option" role="option" data-lang="es">Español</button></li>
          <li><button type="button" class="lang-option" role="option" data-lang="en">English</button></li>
        </ul>
      </div>

      <button id="menu-toggle" class="menu-btn" data-i18n-aria="nav.menu.aria" aria-label="Abrir menú" aria-expanded="false">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </nav>
</header>

<div id="mobile-menu" class="mobile-menu" aria-hidden="true">
  <ul role="list">
    {navLinks.map((link) => (
      <li>
        <a href={link.href} class="mobile-link" data-i18n={link.key}>{link.label}</a>
      </li>
    ))}
  </ul>
  <!-- Language options in mobile menu -->
  <div class="mobile-lang">
    <button type="button" class="lang-option mobile-lang-btn" data-lang="es">Español</button>
    <button type="button" class="lang-option mobile-lang-btn" data-lang="en">English</button>
  </div>
</div>

<style>
  /* Floating pill navbar */
  #navbar {
    position: fixed;
    top: 14px;
    left: 50%;
    transform: translateX(-50%);
    width: min(1120px, calc(100% - 2rem));
    z-index: 100;
    /* Right inset (11px + 1px border) matches the 12px above/below the language button,
       so its rounded edge stays concentric with the navbar's curve */
    padding: 0 11px 0 1.25rem;
    /* Transparent at the top of the page; the pill background appears once scrolled */
    background: transparent;
    border: 1px solid transparent;
    border-radius: 100px;
    transition: background-color 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  #navbar.scrolled {
    background: rgba(13, 21, 32, 0.6);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-color: #1A2535;
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.35), inset 0 1px 0 rgba(255, 255, 255, 0.04);
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }

  .brand-logo {
    height: 30px;
    width: auto;
    display: block;
  }

  .brand-text {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: 0.05em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 0.15rem;
    list-style: none;
  }

  .nav-link {
    display: block;
    padding: 0.45rem 0.85rem;
    border-radius: 100px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: #8899AA;
    text-decoration: none;
    letter-spacing: 0.02em;
    transition: color 0.25s ease, background-color 0.25s ease;
  }
  .nav-link:hover { color: #E8EDF2; background: rgba(255, 255, 255, 0.04); }
  /* Section currently in view (set by the observer below) */
  .nav-link.active {
    color: #00FF87;
    background: #00FF8712;
    box-shadow: inset 0 0 0 1px #00FF8730;
  }

  /* ── Right side group ─────────────────────────────────── */
  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  /* ── Language dropdown ────────────────────────────────── */
  .lang-select { position: relative; }

  .lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0 0.8rem;
    height: 34px;
    background: transparent;
    border: 1px solid #1A2535;
    border-radius: 100px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 500;
    color: #A0B4C8;
    cursor: pointer;
    transition: border-color 0.25s ease, color 0.25s ease;
  }
  .lang-trigger:hover,
  .lang-select.open .lang-trigger {
    border-color: #00FF8760;
    color: #00FF87;
  }
  .lang-chevron { transition: transform 0.25s ease; }
  .lang-select.open .lang-chevron { transform: rotate(180deg); }

  .lang-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    min-width: 150px;
    list-style: none;
    padding: 0.35rem;
    background: rgba(13, 21, 32, 0.95);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid #1A2535;
    border-radius: 14px;
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.45);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }
  .lang-select.open .lang-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .lang-option {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.8rem;
    background: none;
    border: none;
    border-radius: 10px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.82rem;
    color: #A0B4C8;
    text-align: left;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .lang-option:hover { background: rgba(255, 255, 255, 0.05); color: #E8EDF2; }
  .lang-option.active { color: #00FF87; }
  .lang-menu .lang-option.active::after {
    content: '✓';
    font-size: 0.75rem;
  }

  /* ── Menu button ─────────────────────────────────────── */
  .menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }
  .menu-btn span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: #E8EDF2;
    transition: all 0.3s ease;
  }

  /* ── Mobile menu ─────────────────────────────────────── */
  .mobile-menu {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 99;
    background: rgba(5, 10, 15, 0.97);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    /* Leaves room for the floating navbar on top */
    padding: 100px clamp(1.25rem, 5vw, 6rem) 2rem;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
    overflow-y: auto;
  }
  .mobile-menu.open {
    transform: translateX(0);
  }
  .mobile-menu ul { list-style: none; }
  .mobile-link {
    display: block;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: #8899AA;
    text-decoration: none;
    padding: 0.75rem 0;
    border-bottom: 1px solid #1A2535;
    transition: color 0.2s ease;
  }
  .mobile-link:hover { color: #00FF87; }

  .mobile-lang {
    display: flex;
    gap: 0.5rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid #1A2535;
  }
  .mobile-lang-btn {
    width: auto;
    padding: 0.55rem 1.1rem;
    border: 1px solid #1A2535;
    border-radius: 100px;
  }
  .mobile-lang-btn.active {
    border-color: #00FF8760;
    background: #00FF8712;
  }

  @media (max-width: 900px) {
    .nav-links { display: none; }
    .menu-btn  { display: flex; }
    .mobile-menu { display: block; }
  }
</style>

<script>
  // Show the navbar background only after leaving the top of the page
  const navbar = document.getElementById('navbar');
  const updateNavbarBg = () => navbar?.classList.toggle('scrolled', window.scrollY > 24);
  window.addEventListener('scroll', updateNavbarBg, { passive: true });
  updateNavbarBg();

  const toggleBtn = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = mobileMenu?.querySelectorAll('.mobile-link');

  toggleBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('open');
    mobileMenu?.classList.toggle('open');
    toggleBtn.setAttribute('aria-expanded', String(!isOpen));
    mobileMenu?.setAttribute('aria-hidden', String(isOpen));
  });

  // Highlight the nav link of the section in the middle of the viewport
  const navLinkEls = document.querySelectorAll<HTMLAnchorElement>('.nav-link');
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;
        navLinkEls.forEach((a) => {
          const sections = (a.dataset.sections ?? '').split(' ');
          a.classList.toggle('active', sections.includes(entry.target.id));
        });
      });
    },
    { rootMargin: '-45% 0px -50% 0px' },
  );
  navLinkEls.forEach((a) => {
    (a.dataset.sections ?? '').split(' ').forEach((id) => {
      const section = document.getElementById(id);
      if (section) observer.observe(section);
    });
  });

  mobileLinks?.forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.remove('open');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      mobileMenu?.setAttribute('aria-hidden', 'true');
    });
  });
</script>
