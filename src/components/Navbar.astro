---
const navLinks = [
  { href: '#about',      label: 'Sobre mí' },
  { href: '#education',  label: 'Educación' },
  { href: '#stack',      label: 'Stack' },
  { href: '#projects',   label: 'Proyectos' },
  { href: '#experience', label: 'Experiencia' },
  { href: '#skills',     label: 'Habilidades' },
  { href: '#contact',    label: 'Contacto' },
];
---

<header id="navbar">
  <nav>
    <a href="/" class="brand" aria-label="Nicolas Rodriguez Forero">
      <img
        src="/images/logo.png"
        alt="Logo Nicolas Rodriguez"
        class="brand-logo"
        onerror="this.style.display='none'; this.nextElementSibling.style.display='block';"
      />
      <span class="brand-text gradient-text" style="display:none;">NRF</span>
    </a>

    <ul class="nav-links" role="list">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="nav-link">{link.label}</a>
        </li>
      ))}
    </ul>

    <button id="menu-toggle" class="menu-btn" aria-label="Abrir menú" aria-expanded="false">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </nav>

  <div id="mobile-menu" class="mobile-menu" aria-hidden="true">
    <ul role="list">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="mobile-link">{link.label}</a>
        </li>
      ))}
    </ul>
  </div>
</header>

<style>
  #navbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: 0 clamp(1.25rem, 5vw, 6rem);
    background: rgba(5, 10, 15, 0.8);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid #1A2535;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 68px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .brand-logo {
    height: 36px;
    width: auto;
    display: block;
  }

  .brand-text {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 800;
    font-size: 1.25rem;
    letter-spacing: 0.05em;
    text-decoration: none;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
    list-style: none;
  }

  .nav-link {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 500;
    color: #8899AA;
    text-decoration: none;
    letter-spacing: 0.02em;
    position: relative;
    transition: color 0.25s ease;
  }
  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: linear-gradient(90deg, #00FF87, #00CFFF);
    transition: width 0.3s ease;
  }
  .nav-link:hover { color: #E8EDF2; }
  .nav-link:hover::after { width: 100%; }

  .menu-btn {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }
  .menu-btn span {
    display: block;
    width: 22px;
    height: 1.5px;
    background: #E8EDF2;
    transition: all 0.3s ease;
  }

  .mobile-menu {
    display: none;
    position: fixed;
    inset: 68px 0 0;
    background: rgba(5, 10, 15, 0.97);
    backdrop-filter: blur(20px);
    padding: 3rem clamp(1.25rem, 5vw, 6rem);
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .mobile-menu.open {
    transform: translateX(0);
  }
  .mobile-menu ul { list-style: none; }
  .mobile-link {
    display: block;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    color: #8899AA;
    text-decoration: none;
    padding: 0.75rem 0;
    border-bottom: 1px solid #1A2535;
    transition: color 0.2s ease;
  }
  .mobile-link:hover { color: #00FF87; }

  @media (max-width: 900px) {
    .nav-links { display: none; }
    .menu-btn  { display: flex; }
    .mobile-menu { display: block; }
  }
</style>

<script>
  const toggleBtn = document.getElementById('menu-toggle');
  const mobileMenu = document.getElementById('mobile-menu');
  const mobileLinks = mobileMenu?.querySelectorAll('.mobile-link');

  toggleBtn?.addEventListener('click', () => {
    const isOpen = mobileMenu?.classList.contains('open');
    mobileMenu?.classList.toggle('open');
    toggleBtn.setAttribute('aria-expanded', String(!isOpen));
    mobileMenu?.setAttribute('aria-hidden', String(isOpen));
  });

  mobileLinks?.forEach((link) => {
    link.addEventListener('click', () => {
      mobileMenu?.classList.remove('open');
      toggleBtn?.setAttribute('aria-expanded', 'false');
      mobileMenu?.setAttribute('aria-hidden', 'true');
    });
  });
</script>
