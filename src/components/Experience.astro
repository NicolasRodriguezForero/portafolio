---
import { experiences } from '../data/experience';
---

<section id="experience">
  <div class="section">
    <p class="section-label">04 — EXPERIENCIA</p>

    <h2 class="section-heading" data-reveal>
      El camino<br />
      <span class="gradient-text">recorrido.</span>
    </h2>

    <div class="timeline">
      <!-- Growing line -->
      <div class="timeline-track">
        <div id="timeline-line"></div>
      </div>

      {experiences.map((exp, index) => (
        <div class={`timeline-item ${index % 2 === 0 ? 'left' : 'right'}`}>
          <div class="timeline-dot">
            <div class={`dot-inner ${exp.type}`}></div>
          </div>
          <div class="timeline-card gradient-border">
            <div class="exp-header">
              <div>
                <span class="exp-period">{exp.period}</span>
                <h3 class="exp-role">{exp.role}</h3>
                <p class="exp-company">{exp.company}</p>
              </div>
              <span class={`exp-type-badge ${exp.type}`}>
                {exp.type === 'work' ? 'Trabajo' : exp.type === 'academic' ? 'Académico' : 'Educación'}
              </span>
            </div>

            <p class="exp-desc">{exp.description}</p>

            <ul class="exp-highlights">
              {exp.highlights.map((h) => (
                <li>
                  <span class="bullet gradient-text">▸</span>
                  {h}
                </li>
              ))}
            </ul>

            <div class="exp-tags">
              {exp.tags.map((tag) => (
                <span class="exp-tag">{tag}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  #experience {
    border-top: 1px solid #1A2535;
  }

  .section-heading {
    font-family: 'Syne', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1.15;
    color: #E8EDF2;
    margin-top: 1rem;
    margin-bottom: 3.5rem;
  }

  /* Timeline layout */
  .timeline {
    position: relative;
    padding-bottom: 2rem;
  }

  .timeline-track {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: #1A2535;
    transform: translateX(-50%);
  }

  #timeline-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, #00FF87, #00CFFF);
    transform-origin: top center;
    transform: scaleY(0);
  }

  /* Timeline items */
  .timeline-item {
    position: relative;
    display: flex;
    align-items: flex-start;
    margin-bottom: 3rem;
    gap: 2rem;
  }

  .timeline-item.left {
    flex-direction: row;
    padding-right: calc(50% + 2rem);
  }
  .timeline-item.right {
    flex-direction: row-reverse;
    padding-left: calc(50% + 2rem);
  }

  .timeline-dot {
    position: absolute;
    left: 50%;
    top: 1.5rem;
    transform: translate(-50%, 0);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #050A0F;
    border: 2px solid #1A2535;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: border-color 0.3s ease;
  }
  .timeline-item:hover .timeline-dot {
    border-color: #00FF87;
  }

  .dot-inner {
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }
  .dot-inner.work     { background: #00FF87; }
  .dot-inner.academic { background: #00CFFF; }
  .dot-inner.education { background: #A0B4C8; }

  /* Cards */
  .timeline-card {
    width: 100%;
    background: #0D1520;
    border-radius: 8px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .exp-period {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4A6070;
    display: block;
    margin-bottom: 0.3rem;
  }
  .exp-role {
    font-family: 'Syne', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1rem;
    color: #E8EDF2;
    margin-bottom: 0.2rem;
  }
  .exp-company {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.82rem;
    color: #8899AA;
  }

  .exp-type-badge {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.65rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.6rem;
    border-radius: 100px;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .exp-type-badge.work     { background: #00FF8710; border: 1px solid #00FF8730; color: #00FF87; }
  .exp-type-badge.academic { background: #00CFFF10; border: 1px solid #00CFFF30; color: #00CFFF; }
  .exp-type-badge.education{ background: #A0B4C810; border: 1px solid #A0B4C830; color: #A0B4C8; }

  .exp-desc {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 300;
    color: #8899AA;
    line-height: 1.7;
  }

  .exp-highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .exp-highlights li {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 400;
    color: #A0B4C8;
    line-height: 1.6;
    display: flex;
    gap: 0.5rem;
  }
  .bullet {
    flex-shrink: 0;
    font-size: 0.7rem;
    margin-top: 0.25rem;
  }

  .exp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding-top: 0.25rem;
  }
  .exp-tag {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    color: #4A6070;
    background: #050A0F;
    border: 1px solid #1A2535;
    border-radius: 100px;
    padding: 0.15rem 0.55rem;
  }

  /* Mobile: single column */
  @media (max-width: 768px) {
    .timeline-track { display: none; }

    .timeline-item,
    .timeline-item.left,
    .timeline-item.right {
      flex-direction: column;
      padding: 0;
      gap: 0;
    }
    .timeline-dot { display: none; }

    .timeline-item {
      border-left: 2px solid #1A2535;
      padding-left: 1.25rem;
      margin-bottom: 2rem;
    }
    .timeline-card { padding: 1.25rem; }
  }
</style>
