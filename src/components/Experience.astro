---
import { experiences } from '../data/experience';
---

<section id="experience">
  <div class="section">
    <p class="section-label" data-i18n="exp.label">02 · EXPERIENCIA</p>

    <h2 class="section-heading" data-reveal data-i18n-html="exp.heading">
      El camino<br />
      <span class="gradient-text">recorrido.</span>
    </h2>
    <p class="section-sub" data-reveal data-i18n="exp.sub">Dónde he trabajado y qué construí en cada lugar.</p>

    <div class="timeline">
      <!-- Growing line -->
      <div class="timeline-track">
        <div id="timeline-line"></div>
      </div>

      {experiences.map((exp, index) => (
        <div class={`timeline-item ${index % 2 === 0 ? 'left' : 'right'}`}>
          <div class="timeline-dot">
            <div class={`dot-inner ${exp.type}`}></div>
          </div>
          <div class="timeline-card">
            <div class="exp-header">
              <div>
                <span class="exp-period" data-i18n={`exp.${exp.id}.period`}>{exp.period}</span>
                <h3 class="exp-role" data-i18n={`exp.${exp.id}.role`}>{exp.role}</h3>
                <p class="exp-company" data-i18n={`exp.${exp.id}.company`}>{exp.company}</p>
                <span class={`exp-type ${exp.type}`}>
                  <span class="type-dot" aria-hidden="true"></span>
                  <span data-i18n={`exp.type.${exp.type}`}>
                    {exp.type === 'work' ? 'Trabajo' : exp.type === 'academic' ? 'Académico' : exp.type === 'education' ? 'Educación' : 'Investigación'}
                  </span>
                </span>
              </div>
              {exp.endDate === 'present' && (
                <span class="exp-status">
                  <span class="status-dot" aria-hidden="true"></span>
                  <span data-i18n="exp.active">Activo</span>
                </span>
              )}
            </div>

            <p class="exp-desc" data-i18n={`exp.${exp.id}.description`}>{exp.description}</p>

            <ul class="exp-highlights">
              {exp.highlights.map((h, hi) => (
                <li>
                  <span class="bullet gradient-text">▸</span>
                  <span data-i18n={`exp.${exp.id}.h${hi}`}>{h}</span>
                </li>
              ))}
            </ul>

            <div class="exp-tags">
              {exp.tags.map((tag) => (
                <span class="exp-tag" data-i18n={`tag.${tag}`}>{tag}</span>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  #experience {
    border-top: 1px solid #1A2535;
  }

  .section-heading {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #E8EDF2;
    margin-top: 1rem;
    margin-bottom: 3.5rem;
  }

  /* Timeline layout */
  .timeline {
    position: relative;
    padding-bottom: 2rem;
  }

  .timeline-track {
    position: absolute;
    left: 50%;
    top: 0;
    bottom: 0;
    width: 1px;
    background: #1A2535;
    transform: translateX(-50%);
  }

  #timeline-line {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: linear-gradient(to bottom, #00FF87, #00CFFF);
    transform-origin: top center;
    transform: scaleY(0);
  }

  /* Timeline items */
  .timeline-item {
    position: relative;
    display: flex;
    align-items: flex-start;
    margin-bottom: 3rem;
    gap: 2rem;
  }

  .timeline-item.left {
    flex-direction: row;
    padding-right: calc(50% + 2rem);
  }
  .timeline-item.right {
    flex-direction: row-reverse;
    padding-left: calc(50% + 2rem);
  }

  .timeline-dot {
    position: absolute;
    left: 50%;
    top: 1.5rem;
    transform: translate(-50%, 0);
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #050A0F;
    border: 2px solid #1A2535;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    transition: border-color 0.3s ease;
  }
  .timeline-item:hover .timeline-dot { border-color: #00FF87; }

  .dot-inner {
    width: 5px;
    height: 5px;
    border-radius: 50%;
  }
  /* Type colors: green is reserved for the "Activo" status */
  .dot-inner.work      { background: #00CFFF; }
  .dot-inner.academic  { background: #F5B14C; }
  .dot-inner.education { background: #A0B4C8; }
  .dot-inner.research  { background: #B47AFF; }

  /* Cards */
  /* Solid, shaded card: darker fill + drop shadow so the text reads clearly over the background */
  .timeline-card {
    width: 100%;
    background: linear-gradient(180deg, #0F1925 0%, #0A121B 100%);
    border: 1px solid #1A2535;
    box-shadow: 0 18px 40px -12px rgba(0, 0, 0, 0.7), inset 0 1px 0 rgba(255, 255, 255, 0.03);
    border-radius: 16px;
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }
  .timeline-item:hover .timeline-card {
    border-color: #2A3A4D;
    box-shadow: 0 24px 50px -12px rgba(0, 0, 0, 0.85), inset 0 1px 0 rgba(255, 255, 255, 0.04);
    transform: translateY(-2px);
  }

  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .exp-period {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4A6070;
    display: block;
    margin-bottom: 0.3rem;
  }
  .exp-role {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1rem;
    color: #E8EDF2;
    margin-bottom: 0.2rem;
  }
  .exp-company {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.82rem;
    color: #8899AA;
  }

  /* Type indicator under the company: colored dot + label */
  .exp-type {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.55rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .type-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
  }
  .exp-type.work      { color: #00CFFF; }
  .exp-type.academic  { color: #F5B14C; }
  .exp-type.education { color: #A0B4C8; }
  .exp-type.research  { color: #B47AFF; }

  /* Current position */
  .exp-status {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.25rem 0.7rem;
    border-radius: 100px;
    background: #00FF8710;
    border: 1px solid #00FF8740;
    color: #00FF87;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00FF87;
    box-shadow: 0 0 8px #00FF87;
    animation: pulse-glow 2s ease-in-out infinite;
  }

  .exp-desc {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 400;
    color: #8899AA;
    line-height: 1.7;
  }

  .exp-highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .exp-highlights li {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 400;
    color: #A0B4C8;
    line-height: 1.6;
    display: flex;
    gap: 0.5rem;
  }
  .bullet {
    flex-shrink: 0;
    font-size: 0.7rem;
    margin-top: 0.25rem;
  }

  .exp-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding-top: 0.25rem;
  }
  .exp-tag {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 500;
    color: #4A6070;
    background: #050A0F;
    border: 1px solid #1A2535;
    border-radius: 100px;
    padding: 0.15rem 0.55rem;
  }

  /* Mobile: single column */
  @media (max-width: 768px) {
    .timeline-track { display: none; }

    .timeline-item,
    .timeline-item.left,
    .timeline-item.right {
      flex-direction: column;
      padding: 0;
      gap: 0;
    }
    .timeline-dot { display: none; }

    .timeline-item {
      border-left: 2px solid #1A2535;
      padding-left: 1.25rem;
      margin-bottom: 2rem;
    }
    .timeline-card { padding: 1.25rem; }
  }
</style>
