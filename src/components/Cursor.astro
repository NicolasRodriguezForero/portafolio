<div id="cursor-dot" aria-hidden="true"></div>
<div id="cursor-ring" aria-hidden="true"></div>

<style>
  #cursor-dot,
  #cursor-ring {
    position: fixed;
    top: 0;
    left: 0;
    pointer-events: none;
    z-index: 9999;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    will-change: transform;
  }

  #cursor-dot {
    width: 6px;
    height: 6px;
    background: #00FF87;
    box-shadow: 0 0 10px #00FF87, 0 0 20px #00FF8760;
  }

  #cursor-ring {
    width: 28px;
    height: 28px;
    border: 1.5px solid #00FF87;
    opacity: 0.35;
    background: transparent;
  }

  @media (pointer: coarse) {
    #cursor-dot,
    #cursor-ring {
      display: none;
    }
  }
</style>
