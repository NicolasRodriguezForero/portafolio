---
---

<section id="hero">
  <!-- Background grid lines -->
  <div class="hero-grid" aria-hidden="true">
    <div class="grid-lines"></div>
    <div class="grid-glow"></div>
  </div>

  <!-- Content -->
  <div class="hero-content">
    <p class="hero-eyebrow">
      <span class="eyebrow-dot"></span><span data-i18n="hero.eyebrow">Bogotá, Colombia · Abierto a nuevas oportunidades</span>
    </p>

    <h1 class="hero-name gradient-text-animated">
      Nicolas Rodriguez Forero
    </h1>

    <div class="hero-typewriter" aria-live="polite">
      <span id="typewriter-text"></span><span class="cursor-blink" aria-hidden="true"></span>
    </div>

    <p class="hero-desc" data-i18n="hero.desc">
            Ingeniero en IA que construye sistemas inteligentes que llegan a producción: RAG, agentes con LangGraph y búsqueda híbrida, sobre un backend sólido en Python, FastAPI y Azure.
          </p>

    <div class="hero-cta">
      <a href="#contact" class="btn-primary">
        <span data-i18n="hero.cta.contact">Contactar</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a href="#projects" class="btn-secondary" data-i18n="hero.cta.projects">Ver proyectos</a>
      <a
        href="/cv/CV_Nicolas_Rodriguez_Forero_ES.pdf"
        class="btn-secondary btn-cv"
        data-i18n-href="hero.cv.href"
        target="_blank"
        rel="noopener"
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
        </svg>
        <span data-i18n="hero.cv">Descargar CV</span>
      </a>

      <div class="hero-socials">
        <a href="https://github.com/NicolasRodriguezForero" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="GitHub">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
          </svg>
        </a>
        <a href="https://www.linkedin.com/in/nicolas-rodriguez-forero-48b651311" target="_blank" rel="noopener noreferrer" class="social-btn" aria-label="LinkedIn">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a href="mailto:niquimiqui@gmail.com" class="social-btn" aria-label="Email">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <rect x="2" y="4" width="20" height="16" rx="2"/>
            <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>
          </svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator" data-i18n-aria="hero.scroll.aria" aria-label="Hacer scroll hacia abajo">
    <span class="scroll-text" data-i18n="hero.scroll">Scroll</span>
    <div class="scroll-line">
      <div class="scroll-dot"></div>
    </div>
  </div>
</section>

<style>
  #hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 0 clamp(1.25rem, 5vw, 6rem);
  }

  /* Background grid */
  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(26, 37, 53, 0.5) 1px, transparent 1px),
      linear-gradient(90deg, rgba(26, 37, 53, 0.5) 1px, transparent 1px);
    background-size: 60px 60px;
    transform: perspective(800px) rotateX(12deg) scale(1.1);
    transform-origin: center bottom;
    opacity: 0.5;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 60%, black 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 60%, black 40%, transparent 100%);
  }

  .grid-glow {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(ellipse at center bottom, #00FF8715 0%, transparent 70%);
    pointer-events: none;
  }

  /* Content */
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    padding-top: 68px;
    padding-bottom: 6rem; /* keeps the CTAs clear of the scroll indicator */
  }

  /* Availability badge */
  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 1rem 0.45rem 0.8rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #A0B4C8;
    background: #00FF870D;
    border: 1px solid #00FF8730;
    border-radius: 100px;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    margin-bottom: 1.75rem;
  }

  .eyebrow-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00FF87;
    box-shadow: 0 0 8px #00FF87;
    animation: pulse-glow 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  .hero-name {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(2.8rem, 7vw, 6.5rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin-bottom: 1.25rem;
  }

  .hero-typewriter {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    font-weight: 400;
    color: #8899AA;
    height: 2.2rem;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    min-height: 2.2rem;
  }

  .hero-desc {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    font-weight: 400;
    color: #8899AA;
    max-width: 520px;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .hero-socials {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .social-btn {
    width: 46px;
    height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: #8899AA;
    background: rgba(13, 21, 32, 0.6);
    border: 1px solid #1A2535;
    transition: color 0.25s ease, border-color 0.25s ease, transform 0.2s ease;
  }
  .social-btn:hover {
    color: #00FF87;
    border-color: #00FF8760;
    transform: translateY(-2px);
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
    isolation: isolate;
    position: relative;
    z-index: 1;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.75rem;
    background: linear-gradient(135deg, #00FF87, #00CFFF);
    background-clip: padding-box;
    -webkit-background-clip: padding-box;
    color: #050A0F;
    -webkit-text-fill-color: #050A0F;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 100px;
    transition: filter 0.2s ease, transform 0.2s ease;
    letter-spacing: 0.02em;
    position: relative;
    z-index: 1;
  }
  .btn-primary:hover {
    filter: brightness(0.9);
    transform: translateY(-2px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.75rem;
    background: transparent;
    color: #E8EDF2;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid #1A2535;
    border-radius: 100px;
    transition: border-color 0.3s ease, color 0.3s ease, transform 0.2s ease;
    letter-spacing: 0.02em;
  }
  .btn-cv { gap: 0.5rem; }
  .btn-secondary:hover {
    border-color: #00FF87;
    color: #00FF87;
    transform: translateY(-2px);
  }

  /* Scroll indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    z-index: 1;
  }

  .scroll-text {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #4A6070;
  }

  .scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, #1A2535, transparent);
    position: relative;
    overflow: hidden;
  }

  .scroll-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #00FF87;
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    animation: scroll-bounce 1.8s ease-in-out infinite;
  }

  @media (max-width: 640px) {
    .scroll-indicator { display: none; }
  }
</style>
