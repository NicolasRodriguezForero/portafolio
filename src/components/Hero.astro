---
---

<section id="hero">
  <!-- Background grid lines -->
  <div class="hero-grid" aria-hidden="true">
    <div class="grid-lines"></div>
    <div class="grid-glow"></div>
  </div>

  <!-- Content -->
  <div class="hero-content">
    <p class="hero-eyebrow">
      <span class="eyebrow-dot"></span>
      Bogotá, Colombia · Disponible para proyectos y trabajo
    </p>

    <h1 class="hero-name gradient-text-animated">
      Nicolas Rodriguez Forero
    </h1>

    <div class="hero-typewriter" aria-live="polite">
      <span id="typewriter-text"></span><span class="cursor-blink" aria-hidden="true"></span>
    </div>

    <p class="hero-desc">
      Construyo sistemas que piensan — desde backends escalables hasta agentes de IA en producción.
    </p>

    <div class="hero-cta">
      <a href="#projects" class="btn-primary">
        Ver proyectos
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a href="#contact" class="btn-secondary">Contactar</a>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="scroll-indicator" aria-label="Hacer scroll hacia abajo">
    <span class="scroll-text">Scroll</span>
    <div class="scroll-line">
      <div class="scroll-dot"></div>
    </div>
  </div>
</section>

<style>
  #hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 0 clamp(1.25rem, 5vw, 6rem);
  }

  /* Background grid */
  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .grid-lines {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(26, 37, 53, 0.5) 1px, transparent 1px),
      linear-gradient(90deg, rgba(26, 37, 53, 0.5) 1px, transparent 1px);
    background-size: 60px 60px;
    transform: perspective(800px) rotateX(12deg) scale(1.1);
    transform-origin: center bottom;
    opacity: 0.5;
    mask-image: radial-gradient(ellipse 80% 60% at 50% 60%, black 40%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 60% at 50% 60%, black 40%, transparent 100%);
  }

  .grid-glow {
    position: absolute;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 600px;
    height: 300px;
    background: radial-gradient(ellipse at center bottom, #00FF8715 0%, transparent 70%);
    pointer-events: none;
  }

  /* Content */
  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    padding-top: 68px;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #4A6070;
    margin-bottom: 1.5rem;
  }

  .eyebrow-dot {
    display: inline-block;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #00FF87;
    box-shadow: 0 0 8px #00FF87;
    animation: pulse-glow 2s ease-in-out infinite;
    flex-shrink: 0;
  }

  .hero-name {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(2.8rem, 7vw, 6.5rem);
    line-height: 1.1;
    letter-spacing: -0.04em;
    margin-bottom: 1.25rem;
  }

  .hero-typewriter {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(1.1rem, 2.5vw, 1.6rem);
    font-weight: 400;
    color: #8899AA;
    height: 2.2rem;
    margin-bottom: 1.5rem;
    display: flex;
    align-items: center;
    min-height: 2.2rem;
  }

  .hero-desc {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: clamp(0.95rem, 1.5vw, 1.1rem);
    font-weight: 400;
    color: #8899AA;
    max-width: 520px;
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
    isolation: isolate;
    position: relative;
    z-index: 1;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.75rem;
    background: linear-gradient(135deg, #00FF87, #00CFFF);
    background-clip: padding-box;
    -webkit-background-clip: padding-box;
    color: #050A0F;
    -webkit-text-fill-color: #050A0F;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 4px;
    transition: filter 0.2s ease, transform 0.2s ease;
    letter-spacing: 0.02em;
    position: relative;
    z-index: 1;
  }
  .btn-primary:hover {
    filter: brightness(0.9);
    transform: translateY(-2px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    padding: 0.75rem 1.75rem;
    background: transparent;
    color: #E8EDF2;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    border: 1px solid #1A2535;
    border-radius: 4px;
    transition: border-color 0.3s ease, color 0.3s ease, transform 0.2s ease;
    letter-spacing: 0.02em;
  }
  .btn-secondary:hover {
    border-color: #00FF87;
    color: #00FF87;
    transform: translateY(-2px);
  }

  /* Scroll indicator */
  .scroll-indicator {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    z-index: 1;
  }

  .scroll-text {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #4A6070;
  }

  .scroll-line {
    width: 1px;
    height: 48px;
    background: linear-gradient(to bottom, #1A2535, transparent);
    position: relative;
    overflow: hidden;
  }

  .scroll-dot {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: #00FF87;
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    animation: scroll-bounce 1.8s ease-in-out infinite;
  }

  @media (max-width: 640px) {
    .scroll-indicator { display: none; }
  }
</style>
