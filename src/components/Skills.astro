---
import { Icon } from 'astro-icon/components';

const skillCategories = [
  {
    name: 'Liderazgo & Gestión',
    slug: 'liderazgo',
    icon: 'lucide:zap',
    color: 'green' as const,
    skills: ['Liderazgo técnico', 'Gestión de proyectos', 'Emprendimiento', 'Toma de decisiones técnicas'],
  },
  {
    name: 'Comunicación',
    slug: 'comunicacion',
    icon: 'lucide:message-circle',
    color: 'cyan' as const,
    skills: ['Comunicación técnica', 'Trabajo en equipo', 'Atención al cliente', 'Documentación de proyectos'],
  },
  {
    name: 'Pensamiento',
    slug: 'pensamiento',
    icon: 'lucide:brain',
    color: 'green' as const,
    skills: ['Pensamiento analítico', 'Resolución de problemas', 'Investigación aplicada', 'Diseño de arquitecturas'],
  },
  {
    name: 'Actitud',
    slug: 'actitud',
    icon: 'lucide:rocket',
    color: 'cyan' as const,
    skills: ['Proactividad', 'Aprendizaje continuo', 'Adaptación a tecnologías', 'Orientación a la calidad'],
  },
];

const languages = [
  { name: 'Español', level: 'Nativo',        code: 'ES', color: 'green' as const, percent: 100 },
  { name: 'Inglés',  level: 'B2 · Avanzado', code: 'EN', color: 'cyan'  as const, percent: 70 },
  { name: 'Francés', level: 'A1 · Básico',   code: 'FR', color: 'green' as const, percent: 18 },
];
---

<section id="skills">
  <div class="section">
    <p class="section-label" data-i18n="skills.label">05 · HABILIDADES</p>

    <h2 class="section-heading" data-reveal data-i18n-html="skills.heading">
      Más allá del<br />
      <span class="gradient-text">código.</span>
    </h2>
    <p class="section-sub" data-reveal data-i18n="skills.sub">Lo que complementa lo técnico: cómo trabajo, cómo me comunico y los idiomas que hablo.</p>

    <div class="skills-layout">
      <!-- Soft skills: one row per category -->
      <dl class="skill-rows">
        {skillCategories.map((cat) => (
          <div class={`skill-row ${cat.color}`} data-reveal>
            <dt class="skill-cat">
              <Icon name={cat.icon} class={`skill-cat-icon ${cat.color}`} aria-hidden="true" />
              <span data-i18n={`skills.cat.${cat.slug}`}>{cat.name}</span>
            </dt>
            <dd class="skill-items">
              {cat.skills.map((skill, si) => (
                <span class="skill-item" data-i18n={`skills.${cat.slug}.${si}`}>{skill}</span>
              ))}
            </dd>
          </div>
        ))}
      </dl>

      <!-- Languages with a level meter -->
      <aside class="languages" data-reveal>
        <h3 class="languages-title" data-i18n="skills.languages.title">Idiomas</h3>
        <ul class="lang-list">
          {languages.map((lang) => (
            <li class="lang-row">
              <div class="lang-head">
                <span class="lang-name" data-i18n={`skills.lang.${lang.code.toLowerCase()}.name`}>{lang.name}</span>
                <span class={`lang-badge ${lang.color}`} data-i18n={`skills.lang.${lang.code.toLowerCase()}.level`}>{lang.level}</span>
              </div>
              <div class="lang-meter" aria-hidden="true">
                <span class={`lang-fill ${lang.color}`} style={`--lvl: ${lang.percent}%`}></span>
              </div>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  #skills {
    border-top: 1px solid #1A2535;
  }

  .section-heading {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #E8EDF2;
    margin-top: 1rem;
    margin-bottom: 3rem;
  }

  .skills-layout {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 4rem;
    align-items: start;
  }

  /* ── Soft skills rows ────────────────────────────────── */
  .skill-row {
    display: grid;
    grid-template-columns: 210px 1fr;
    gap: 1.5rem;
    padding: 1.35rem 0;
    border-top: 1px solid #1A2535;
  }
  .skill-row:last-child { border-bottom: 1px solid #1A2535; }

  .skill-cat {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #A0B4C8;
  }

  .skill-cat-icon { width: 1.1rem; height: 1.1rem; flex-shrink: 0; }
  .skill-cat-icon.green { color: #00FF87; }
  .skill-cat-icon.cyan  { color: #00CFFF; }

  /* Two-column list; each item has its own accent dot so wrapping stays tidy */
  .skill-items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.45rem 1.5rem;
  }

  .skill-item {
    position: relative;
    padding-left: 0.9rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.9rem;
    color: #C8D4DE;
  }
  .skill-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 4px;
    height: 4px;
    border-radius: 50%;
  }
  .skill-row.green .skill-item::before { background: #00FF87; }
  .skill-row.cyan  .skill-item::before { background: #00CFFF; }

  /* ── Languages ───────────────────────────────────────── */
  .languages-title {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #4A6070;
    margin-bottom: 1.5rem;
  }

  .lang-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .lang-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 0.6rem;
  }

  .lang-name {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: #E8EDF2;
  }

  .lang-badge {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .lang-badge.green { color: #00FF87; }
  .lang-badge.cyan  { color: #00CFFF; }

  .lang-meter {
    height: 4px;
    border-radius: 100px;
    background: #1A2535;
    overflow: hidden;
  }
  .lang-fill {
    display: block;
    height: 100%;
    width: var(--lvl);
    border-radius: inherit;
  }
  .lang-fill.green { background: linear-gradient(90deg, #00FF87, #00FF8760); }
  .lang-fill.cyan  { background: linear-gradient(90deg, #00CFFF, #00CFFF60); }

  @media (max-width: 900px) {
    .skills-layout { grid-template-columns: 1fr; gap: 3rem; }
  }
  @media (max-width: 640px) {
    .skill-row { grid-template-columns: 1fr; gap: 0.75rem; }
  }
</style>
