---
import { Icon } from 'astro-icon/components';

const skillCategories = [
  {
    name: 'Liderazgo & Gestión',
    icon: 'lucide:zap',
    color: 'green' as const,
    skills: ['Liderazgo técnico', 'Gestión de proyectos', 'Emprendimiento', 'Toma de decisiones técnicas'],
  },
  {
    name: 'Comunicación',
    icon: 'lucide:message-circle',
    color: 'cyan' as const,
    skills: ['Comunicación técnica', 'Trabajo en equipo', 'Atención al cliente', 'Documentación de proyectos'],
  },
  {
    name: 'Pensamiento',
    icon: 'lucide:brain',
    color: 'green' as const,
    skills: ['Pensamiento analítico', 'Resolución de problemas', 'Investigación aplicada', 'Diseño de arquitecturas'],
  },
  {
    name: 'Actitud',
    icon: 'lucide:rocket',
    color: 'cyan' as const,
    skills: ['Proactividad', 'Aprendizaje continuo', 'Adaptación a tecnologías', 'Orientación a la calidad'],
  },
];

const languages = [
  { name: 'Español', level: 'Nativo',       code: 'ES', color: 'green' as const },
  { name: 'Inglés',  level: 'B2 — Avanzado', code: 'EN', color: 'cyan'  as const },
  { name: 'Francés', level: 'A1 — Básico',   code: 'FR', color: 'green' as const },
];
---

<section id="skills">
  <div class="section">
    <p class="section-label">06 — HABILIDADES</p>

    <h2 class="section-heading" data-reveal>
      Más allá del<br />
      <span class="gradient-text">código.</span>
    </h2>

    <div class="skills-grid" data-stagger>
      {skillCategories.map((cat) => (
        <div class={`skill-card ${cat.color}`} data-stagger-item>
          <div class="skill-card-header">
            <Icon name={cat.icon} class={`skill-cat-icon ${cat.color}`} aria-hidden="true" />
            <span class="skill-cat-name">{cat.name}</span>
          </div>
          <div class="skill-tags">
            {cat.skills.map((skill) => (
              <span class={`skill-tag ${cat.color}`}>{skill}</span>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Languages -->
    <div class="languages-block" data-reveal>
      <h3 class="languages-title">Idiomas</h3>
      <div class="lang-cards">
        {languages.map((lang) => (
          <div class={`lang-card ${lang.color}`}>
            <span class="lang-code" aria-hidden="true">{lang.code}</span>
            <div class="lang-info">
              <span class="lang-name">{lang.name}</span>
              <span class={`lang-badge ${lang.color}`}>{lang.level}</span>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  #skills {
    border-top: 1px solid #1A2535;
  }

  .section-heading {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #E8EDF2;
    margin-top: 1rem;
    margin-bottom: 3rem;
  }

  /* ── Skill cards grid ─────────────────────────────────── */
  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
    margin-bottom: 3rem;
  }

  .skill-card {
    position: relative;
    background: #0D1520;
    border: 1px solid #1A2535;
    border-radius: 10px;
    padding: 1.5rem;
    overflow: hidden;
    transition: border-color 0.3s ease;
  }
  .skill-card.green:hover { border-color: #00FF8760; }
  .skill-card.cyan:hover  { border-color: #00CFFF60; }

  /* Top accent bar — same pattern as project cards */
  .skill-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
  }
  .skill-card.green::before { background: linear-gradient(90deg, #00FF87, transparent); }
  .skill-card.cyan::before  { background: linear-gradient(90deg, #00CFFF, transparent); }

  .skill-card-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #1A2535;
  }

  .skill-cat-icon {
    width: 1.1rem;
    height: 1.1rem;
    flex-shrink: 0;
  }
  .skill-cat-icon.green { color: #00FF87; }
  .skill-cat-icon.cyan  { color: #00CFFF; }

  .skill-cat-name {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #A0B4C8;
  }

  /* Skill tags — wrap pills, no level indicator */
  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .skill-tag {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 500;
    padding: 0.32rem 0.85rem;
    border-radius: 100px;
    background: #050A0F;
    border: 1px solid #1A2535;
    color: #8899AA;
    transition: border-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
  }

  /* All tags in a card light up together on card hover */
  .skill-card.green:hover .skill-tag {
    border-color: #00FF8745;
    color: #C8DDE8;
    box-shadow: 0 0 10px #00FF8710;
  }
  .skill-card.cyan:hover .skill-tag {
    border-color: #00CFFF45;
    color: #C8DDE8;
    box-shadow: 0 0 10px #00CFFF10;
  }

  /* ── Language cards ───────────────────────────────────── */
  .languages-block {
    background: #0D1520;
    border: 1px solid #1A2535;
    border-radius: 10px;
    padding: 1.75rem;
  }

  .languages-title {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #4A6070;
    margin-bottom: 1.25rem;
  }

  .lang-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .lang-card {
    position: relative;
    background: #050A0F;
    border: 1px solid #1A2535;
    border-radius: 8px;
    padding: 1.25rem 1.25rem 1.25rem 1.5rem;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
    min-height: 100px;
    transition: border-color 0.3s ease;
  }
  .lang-card.green:hover { border-color: #00FF8760; }
  .lang-card.cyan:hover  { border-color: #00CFFF60; }

  /* Left accent bar */
  .lang-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 2px;
    border-radius: 8px 0 0 8px;
  }
  .lang-card.green::before { background: linear-gradient(to bottom, #00FF87, transparent); }
  .lang-card.cyan::before  { background: linear-gradient(to bottom, #00CFFF, transparent); }

  /* Big decorative language code in the background */
  .lang-code {
    position: absolute;
    top: -0.35rem;
    right: 0.6rem;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 800;
    font-size: 4.5rem;
    letter-spacing: -0.05em;
    line-height: 1;
    color: #E8EDF20D;
    user-select: none;
    pointer-events: none;
  }

  .lang-info {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .lang-name {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: #E8EDF2;
    line-height: 1;
  }

  .lang-badge {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .lang-badge.green { color: #00FF87; }
  .lang-badge.cyan  { color: #00CFFF; }

  /* ── Responsive ───────────────────────────────────────── */
  @media (max-width: 640px) {
    .skills-grid    { grid-template-columns: 1fr; }
    .lang-cards     { grid-template-columns: 1fr; }
  }
</style>
