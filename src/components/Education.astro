---
const education = [
  {
    institution: 'Universidad Sergio Arboleda',
    degree: 'Ingeniería en Ciencias de la Computación e Inteligencia Artificial',
    period: '2022 — Presente',
    location: 'Bogotá, Colombia',
    type: 'Pregrado',
    highlights: [
      'Programa de Honores "Rodrigo Noguera Laborde" — 2025-II y 2026-I',
      'Enfoque en sistemas de IA, arquitecturas de software y ciencias de la computación',
      'Proyectos académicos con integración de aprendizaje de máquina y desarrollo de software',
    ],
    color: 'green' as const,
    icon: '🎓',
  },
  {
    institution: 'Escuela de Negocios PRIME · Universidad Sergio Arboleda',
    degree: 'Diplomado en Analítica de Datos y Big Data',
    period: 'Abr 2026 — Presente',
    location: 'Bogotá, Colombia',
    type: 'Diplomado ejecutivo',
    highlights: [
      'Análisis descriptivo, estadístico y predictivo de datos',
      'Procesamiento de datos con Python y R',
      'Fundamentos de Big Data y arquitecturas de datos a escala',
    ],
    color: 'cyan' as const,
    icon: '📊',
  },
];
---

<section id="education">
  <div class="section">
    <p class="section-label">02 — EDUCACIÓN</p>

    <h2 class="section-heading" data-reveal>
      Donde aprendí a<br />
      <span class="gradient-text">pensar en grande.</span>
    </h2>

    <div class="edu-grid">
      {education.map((item, i) => (
        <div class={`edu-card ${item.color}`} data-reveal>
          <div class={`edu-accent ${item.color}`}></div>

          <div class="edu-body">
            <div class="edu-meta">
              <span class={`edu-badge ${item.color}`}>{item.type}</span>
              <span class="edu-period">{item.period}</span>
            </div>

            <div class="edu-icon" aria-hidden="true">{item.icon}</div>

            <h3 class="edu-degree">{item.degree}</h3>
            <p class="edu-institution">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" style="display:inline;vertical-align:middle;margin-right:4px;">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
              </svg>
              {item.institution} · {item.location}
            </p>

            <ul class="edu-highlights">
              {item.highlights.map((h) => (
                <li>
                  <span class={`bullet ${item.color}`}>▸</span>
                  {h}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  #education {
    border-top: 1px solid #1A2535;
  }

  .section-heading {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #E8EDF2;
    margin-top: 1rem;
    margin-bottom: 3rem;
  }

  .edu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(420px, 1fr));
    gap: 1.5rem;
  }

  .edu-card {
    background: #0D1520;
    border: 1px solid #1A2535;
    border-radius: 10px;
    overflow: hidden;
    transition: border-color 0.3s ease;
  }
  .edu-card.green:hover { border-color: #00FF8760; }
  .edu-card.cyan:hover  { border-color: #00CFFF60; }

  .edu-accent {
    height: 2px;
    width: 100%;
  }
  .edu-accent.green { background: linear-gradient(90deg, #00FF87, transparent); }
  .edu-accent.cyan  { background: linear-gradient(90deg, #00CFFF, transparent); }

  .edu-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .edu-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .edu-badge {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.65rem;
    border-radius: 100px;
  }
  .edu-badge.green { background: #00FF8710; border: 1px solid #00FF8730; color: #00FF87; }
  .edu-badge.cyan  { background: #00CFFF10; border: 1px solid #00CFFF30; color: #00CFFF; }

  .edu-period {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.75rem;
    color: #4A6070;
    letter-spacing: 0.05em;
  }

  .edu-icon {
    font-size: 2rem;
    line-height: 1;
  }

  .edu-degree {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 700;
    font-size: 1.1rem;
    color: #E8EDF2;
    line-height: 1.3;
  }

  .edu-institution {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.82rem;
    color: #8899AA;
    line-height: 1.5;
  }

  .edu-highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-top: 0.25rem;
  }
  .edu-highlights li {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.82rem;
    color: #A0B4C8;
    line-height: 1.6;
    display: flex;
    gap: 0.5rem;
  }
  .bullet {
    flex-shrink: 0;
    font-size: 0.65rem;
    margin-top: 0.3rem;
  }
  .bullet.green { color: #00FF87; }
  .bullet.cyan  { color: #00CFFF; }

  @media (max-width: 640px) {
    .edu-grid { grid-template-columns: 1fr; }
  }
</style>
