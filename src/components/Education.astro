---
import { Icon } from 'astro-icon/components';

const education = [
  {
    id: 'pregrado',
    institution: 'Universidad Sergio Arboleda',
    degree: 'Ingeniero en Ciencias de la Computación e Inteligencia Artificial',
    period: 'Feb 2022 - Sep 2026',
    location: 'Bogotá, Colombia',
    type: 'Graduado · Cum Laude',
    highlights: [
      'Graduado Cum Laude (septiembre de 2026)',
      'Programa de Honores "Rodrigo Noguera Laborde": 2025-I, 2025-II y 2026-I',
      'Proyecto de grado: OrbitEngine, plataforma SaaS multi-tenant para PyMEs',
    ],
    color: 'green' as const,
    icon: 'lucide:graduation-cap',
  },
  {
    id: 'diplomado',
    institution: 'Escuela de Negocios PRIME · Universidad Sergio Arboleda',
    degree: 'Diplomado en Analítica de Datos y Big Data',
    period: 'Abr - Jun 2026',
    location: 'Bogotá, Colombia',
    type: 'Diplomado ejecutivo · 120 h',
    highlights: [
      'Análisis descriptivo, estadístico y predictivo de datos',
      'Procesamiento de datos con Python y R',
      'Fundamentos de Big Data y arquitecturas de datos a escala',
    ],
    color: 'cyan' as const,
    icon: 'lucide:bar-chart-2',
  },
];

const awards = [
  {
    id: 'cumlaude',
    title: 'Graduado Cum Laude',
    meta: 'Universidad Sergio Arboleda · Sep 2026',
    desc: 'Ingeniería en Ciencias de la Computación e Inteligencia Artificial',
    icon: 'lucide:award',
    color: 'green' as const,
  },
  {
    id: 'honores',
    title: 'Programa de Honores "Rodrigo Noguera Laborde"',
    meta: '2025-I · 2025-II · 2026-I',
    desc: 'Seleccionado tres semestres consecutivos por excelencia académica',
    icon: 'lucide:star',
    color: 'cyan' as const,
  },
  {
    id: 'datafest',
    title: 'Ponente en Data Fest 2026',
    meta: 'Universidad Sergio Arboleda · May 2026',
    desc: 'ATLAS: sistema agéntico de orientación normativa y jurisprudencial sobre playas en Colombia',
    icon: 'lucide:mic',
    color: 'green' as const,
  },
  {
    id: 'awsclub',
    title: 'AWS Cloud Club · Core Team',
    meta: 'Universidad Sergio Arboleda · Ene 2026 - Presente',
    desc: 'Apoyo en eventos de la comunidad y mentoría a estudiantes que empiezan en cloud computing',
    icon: 'lucide:cloud',
    color: 'cyan' as const,
  },
];

const certifications = [
  {
    id: 'claudecode',
    title: 'Claude Code in Action',
    meta: 'Anthropic · Abr 2026',
    desc: 'Desarrollo asistido por agentes de IA con Claude Code',
    icon: 'lucide:terminal',
    color: 'green' as const,
    url: 'https://verify.skilljar.com/c/uektezzg6do2',
  },
  {
    id: 'oraclesql',
    title: 'Database Design and Programming with SQL',
    meta: 'Oracle Academy · Jun 2024',
    desc: 'Modelado relacional, normalización y programación en SQL',
    icon: 'lucide:database',
    color: 'cyan' as const,
    url: null,
  },
  {
    id: 'datacamp',
    title: 'Machine Learning & Deep Learning',
    meta: 'DataCamp · 2025 - 2026',
    desc: 'Deep Learning con Keras (intro y avanzado), preprocesamiento para ML y analítica predictiva en Python',
    icon: 'lucide:brain-circuit',
    color: 'green' as const,
    url: null,
  },
];
---

<section id="education">
  <div class="section">
    <p class="section-label" data-i18n="edu.label">06 · EDUCACIÓN</p>

    <h2 class="section-heading" data-reveal data-i18n-html="edu.heading">
      Donde aprendí a<br />
      <span class="gradient-text">pensar en grande.</span>
    </h2>
    <p class="section-sub" data-reveal data-i18n="edu.sub">Formación en IA y computación, más las certificaciones que respaldan lo que construyo.</p>

    <!-- Degrees: date column + content, joined by a vertical rule -->
    <ol class="edu-list">
      {education.map((item) => (
        <li class={`edu-row ${item.color}`} data-reveal>
          <div class="edu-when">
            <span class="edu-period" data-i18n={`edu.${item.id}.period`}>{item.period}</span>
            <span class={`edu-node ${item.color}`} aria-hidden="true">
              <Icon name={item.icon} />
            </span>
          </div>
          <div class="edu-content">
            <span class={`edu-badge ${item.color}`} data-i18n={`edu.${item.id}.type`}>{item.type}</span>
            <h3 class="edu-degree" data-i18n={`edu.${item.id}.degree`}>{item.degree}</h3>
            <p class="edu-institution" data-i18n={`edu.${item.id}.institution`}>{item.institution} · {item.location}</p>
            <ul class="edu-highlights">
              {item.highlights.map((h, hi) => (
                <li>
                  <span class={`bullet ${item.color}`}>▸</span>
                  <span data-i18n={`edu.${item.id}.h${hi}`}>{h}</span>
                </li>
              ))}
            </ul>
          </div>
        </li>
      ))}
    </ol>

    <!-- Recognitions: one horizontal strip -->
    <h3 class="cred-label" data-reveal data-i18n="edu.awards.label">Reconocimientos</h3>
    <div class="awards-strip" data-reveal>
      {awards.map((item) => (
        <div class="award">
          <span class={`award-icon ${item.color}`}><Icon name={item.icon} aria-hidden="true" /></span>
          <h4 class="award-title" data-i18n={`edu.${item.id}.title`}>{item.title}</h4>
          <p class="award-meta" data-i18n={`edu.${item.id}.meta`}>{item.meta}</p>
          <p class="award-desc" data-i18n={`edu.${item.id}.desc`}>{item.desc}</p>
        </div>
      ))}
    </div>

    <!-- Certifications: compact list -->
    <h3 class="cred-label" data-reveal data-i18n="edu.certs.label">Certificaciones</h3>
    <ul class="cert-list">
      {certifications.map((item) => (
        <li class="cert-row" data-reveal>
          <span class={`cert-icon ${item.color}`}><Icon name={item.icon} aria-hidden="true" /></span>
          <div class="cert-main">
            <h4 class="cert-title" data-i18n={`edu.${item.id}.title`}>{item.title}</h4>
            <p class="cert-desc" data-i18n={`edu.${item.id}.desc`}>{item.desc}</p>
          </div>
          <p class="cert-meta" data-i18n={`edu.${item.id}.meta`}>{item.meta}</p>
          {item.url ? (
            <a href={item.url} target="_blank" rel="noopener noreferrer" class={`cert-verify ${item.color}`}>
              <span data-i18n="edu.verify">Verificar credencial</span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6M15 3h6v6M10 14L21 3"/>
              </svg>
            </a>
          ) : (
            <span class="cert-verify placeholder" aria-hidden="true"></span>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  #education {
    border-top: 1px solid #1A2535;
  }

  .section-heading {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1.15;
    letter-spacing: -0.03em;
    color: #E8EDF2;
    margin-top: 1rem;
    margin-bottom: 3rem;
  }

  /* ── Degrees ─────────────────────────────────────────── */
  .edu-list { list-style: none; }

  .edu-row {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 2.5rem;
  }

  .edu-when {
    position: relative;
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
  }
  /* Vertical rule linking the nodes */
  .edu-when::after {
    content: '';
    position: absolute;
    right: 17px;
    top: 40px;
    bottom: -0.25rem;
    width: 1px;
    background: linear-gradient(to bottom, #1A2535, transparent);
  }
  .edu-row:last-child .edu-when::after { display: none; }

  .edu-period {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #4A6070;
    padding-top: 0.6rem;
  }

  .edu-node {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #050A0F;
    border: 1px solid #1A2535;
    flex-shrink: 0;
  }
  .edu-node :global(svg) { width: 1rem; height: 1rem; }
  .edu-node.green { color: #00FF87; border-color: #00FF8740; }
  .edu-node.cyan  { color: #00CFFF; border-color: #00CFFF40; }

  .edu-content {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
    padding-bottom: 2.75rem;
  }

  .edu-badge {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.65rem;
    border-radius: 100px;
    width: fit-content;
  }
  .edu-badge.green { background: #00FF8710; border: 1px solid #00FF8730; color: #00FF87; }
  .edu-badge.cyan  { background: #00CFFF10; border: 1px solid #00CFFF30; color: #00CFFF; }

  .edu-degree {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    color: #E8EDF2;
    line-height: 1.3;
  }

  .edu-institution {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.85rem;
    color: #8899AA;
  }

  .edu-highlights {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    margin-top: 0.3rem;
  }
  .edu-highlights li {
    display: flex;
    gap: 0.5rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.84rem;
    color: #A0B4C8;
    line-height: 1.6;
  }
  .bullet { flex-shrink: 0; font-size: 0.65rem; margin-top: 0.3rem; }
  .bullet.green { color: #00FF87; }
  .bullet.cyan  { color: #00CFFF; }

  /* ── Recognitions strip ──────────────────────────────── */
  .cred-label {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #4A6070;
    margin: 1.5rem 0 1.25rem;
  }

  .awards-strip {
    display: flex;
    border-top: 1px solid #1A2535;
    border-bottom: 1px solid #1A2535;
    margin-bottom: 3rem;
  }

  .award {
    flex: 1;
    padding: 1.5rem 1.5rem 1.5rem 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }
  .award + .award {
    padding-left: 1.5rem;
    border-left: 1px solid #1A2535;
  }

  .award-icon :global(svg) { width: 1.35rem; height: 1.35rem; margin-bottom: 0.35rem; }
  .award-icon.green { color: #00FF87; }
  .award-icon.cyan  { color: #00CFFF; }

  .award-title {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    color: #E8EDF2;
    line-height: 1.35;
  }
  .award-meta {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.72rem;
    color: #4A6070;
    letter-spacing: 0.03em;
  }
  .award-desc {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.8rem;
    color: #8899AA;
    line-height: 1.55;
  }

  /* ── Certifications list ─────────────────────────────── */
  .cert-list { list-style: none; }

  .cert-row {
    display: grid;
    grid-template-columns: auto 1fr auto 150px;
    align-items: center;
    gap: 1.25rem;
    padding: 1.1rem 0.75rem;
    border-top: 1px solid #1A2535;
    transition: background-color 0.25s ease;
  }
  .cert-row:last-child { border-bottom: 1px solid #1A2535; }
  .cert-row:hover { background: rgba(255, 255, 255, 0.02); }

  .cert-icon :global(svg) { width: 1.2rem; height: 1.2rem; display: block; }
  .cert-icon.green { color: #00FF87; }
  .cert-icon.cyan  { color: #00CFFF; }

  .cert-main { min-width: 0; }
  .cert-title {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 700;
    font-size: 0.95rem;
    color: #E8EDF2;
  }
  .cert-desc {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.8rem;
    color: #8899AA;
    line-height: 1.5;
  }
  .cert-meta {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.75rem;
    color: #4A6070;
    white-space: nowrap;
  }

  .cert-verify {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.35rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .cert-verify:hover { opacity: 0.75; }
  .cert-verify.green { color: #00FF87; }
  .cert-verify.cyan  { color: #00CFFF; }

  @media (max-width: 900px) {
    .awards-strip { flex-wrap: wrap; }
    .award { flex: 1 1 50%; }
    .award:nth-child(odd) { padding-left: 0; border-left: none; }
    .award:nth-child(n + 3) { border-top: 1px solid #1A2535; }
  }

  @media (max-width: 640px) {
    .edu-row { grid-template-columns: 1fr; gap: 0.75rem; }
    .edu-when { flex-direction: row-reverse; justify-content: flex-end; align-items: center; gap: 0.75rem; }
    .edu-when::after { display: none; }
    .edu-period { padding-top: 0; }
    .edu-content { padding-bottom: 2rem; }

    .award { flex: 1 1 100%; padding-left: 0; border-left: none; }
    .award + .award { padding-left: 0; border-left: none; border-top: 1px solid #1A2535; }

    .cert-row { grid-template-columns: auto 1fr; row-gap: 0.4rem; }
    .cert-meta, .cert-verify { grid-column: 2; justify-content: flex-start; }
    .cert-verify.placeholder { display: none; }
  }
</style>
