---
import { Icon } from 'astro-icon/components';
import { techStack } from '../data/techStack';

const cellMeta = [
  { area: 'lenguajes', accent: 'cyan',  featured: true  },
  { area: 'frontend',  accent: 'green', featured: false },
  { area: 'backend',   accent: 'cyan',  featured: false },
  { area: 'ia',        accent: 'green', featured: true  },
  { area: 'databases', accent: 'cyan',  featured: false },
  { area: 'cloud',     accent: 'green', featured: false },
];
---

<section id="stack">
  <div class="section">
    <p class="section-label" data-i18n="stack.label">03 — STACK</p>

    <h2 class="section-heading" data-reveal data-i18n-html="stack.heading">
      Herramientas que<br />
      <span class="gradient-text">domino.</span>
    </h2>

    <div class="bento-grid" data-stagger>
      {techStack.map((category, i) => {
        const { accent, featured } = cellMeta[i];
        return (
          <div
            class={`bento-cell bento-cell-${i} ${accent}${featured ? ' featured' : ''}`}
            data-stagger-item
          >
            <div class="cell-header">
              <Icon name={category.icon} class={`cell-icon ${accent}`} aria-hidden="true" />
              <span class="cell-name" data-i18n={`stack.cat.${cellMeta[i].area}`}>{category.name}</span>
            </div>
            <div class="pills">
              {category.items.map((item) => (
                <div class={`tech-pill ${item.level}`} title={item.name}>
                  <Icon name={item.icon} class:list={['tech-icon', { invert: item.invert }]} aria-hidden="true" />
                  <span>{item.name}</span>
                </div>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  #stack {
    border-top: 1px solid #1A2535;
  }

  .section-heading {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-weight: 800;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    line-height: 1.15;
    color: #E8EDF2;
    margin-top: 1rem;
    margin-bottom: 3rem;
  }

  /* ── Bento grid ────────────────────────────────────────── */
  .bento-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-template-areas:
      "lenguajes lenguajes frontend  cloud"
      "backend   ia        ia        databases";
    gap: 1rem;
  }

  .bento-cell-0 { grid-area: lenguajes; }
  .bento-cell-1 { grid-area: frontend;  }
  .bento-cell-2 { grid-area: backend;   }
  .bento-cell-3 { grid-area: ia;        }
  .bento-cell-4 { grid-area: databases; }
  .bento-cell-5 { grid-area: cloud;     }

  .bento-cell {
    position: relative;
    background: #0D1520;
    border: 1px solid #1A2535;
    border-radius: 14px;
    padding: 1.5rem;
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
  }

  .bento-cell::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 2px;
    border-radius: 14px 14px 0 0;
  }
  .bento-cell.cyan::before  { background: linear-gradient(90deg, #00CFFF, transparent); }
  .bento-cell.green::before { background: linear-gradient(90deg, #00FF87, transparent); }

  .bento-cell.featured.cyan  { background: radial-gradient(ellipse at 85% 15%, #00CFFF0A 0%, #0D1520 55%); }
  .bento-cell.featured.green { background: radial-gradient(ellipse at 15% 85%, #00FF870A 0%, #0D1520 55%); }

  .bento-cell.cyan:hover  { border-color: #00CFFF40; box-shadow: 0 4px 32px #00CFFF08; }
  .bento-cell.green:hover { border-color: #00FF8740; box-shadow: 0 4px 32px #00FF8708; }
  .bento-cell.featured.cyan:hover  { border-color: #00CFFF60; box-shadow: 0 4px 40px #00CFFF14; }
  .bento-cell.featured.green:hover { border-color: #00FF8760; box-shadow: 0 4px 40px #00FF8714; }

  .cell-header {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid #1A2535;
  }

  .cell-icon { width: 16px; height: 16px; flex-shrink: 0; }
  .cell-icon.cyan  { color: #00CFFF; }
  .cell-icon.green { color: #00FF87; }

  .cell-name {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #4A6070;
  }

  .pills { display: flex; flex-wrap: wrap; gap: 0.5rem; }

  .tech-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.75rem;
    background: #050A0F;
    border: 1px solid #1A2535;
    border-radius: 100px;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.78rem;
    font-weight: 400;
    color: #8899AA;
    transition: border-color 0.25s ease, color 0.25s ease;
    cursor: default;
  }
  .tech-pill.primary { color: #C8DDE8; border-color: #2A3545; }

  .bento-cell.cyan:hover  .tech-pill { border-color: #00CFFF20; }
  .bento-cell.green:hover .tech-pill { border-color: #00FF8720; }
  .bento-cell.cyan:hover  .tech-pill.primary { border-color: #00CFFF50; color: #E8EDF2; }
  .bento-cell.green:hover .tech-pill.primary { border-color: #00FF8750; color: #E8EDF2; }

  .tech-icon { width: 14px; height: 14px; flex-shrink: 0; }
  .tech-icon.invert { filter: invert(1) brightness(2); }

  @media (max-width: 900px) {
    .bento-grid {
      grid-template-columns: repeat(2, 1fr);
      grid-template-areas:
        "lenguajes lenguajes"
        "frontend  cloud"
        "ia        ia"
        "backend   databases";
    }
  }

  @media (max-width: 560px) {
    .bento-grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        "lenguajes"
        "frontend"
        "backend"
        "ia"
        "databases"
        "cloud";
    }
  }
</style>
